      "id": "official_primary_source",
      "input": {
        "query": "What does Rust's Result type represent? Use official documentation.",
        "extra_sources": 1,
        "include_content": false
      },
      "ai_answer": "Rust Result represents success with Ok or failure with Err.",
      "ai_sources": [
        {
          "url": "https://doc.rust-lang.org/std/result/",
          "provider": "grok_responses",
          "title": "std::result - Rust"
        }
      ],
      "supplemental_sources": [
        {
          "url": "https://blog.rust-lang.org/inside-rust/",
          "provider": "tavily",
          "title": "Inside Rust Blog"
        }
      ],
      "expected": {
        "answer_contains": ["Result", "Ok", "Err"],
        "required_domain_groups": [
          { "domains": ["doc.rust-lang.org"], "top_k": 3 }
        ],
        "min_unique_hosts": 2,
        "expected_source_count": 2
      }
    },
